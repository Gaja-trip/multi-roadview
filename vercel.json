{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node -e \"console.log('Web build uses no npm dependencies')\"",
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "dist",
  "functions": { "api/search.js": { "maxDuration": 30, "includeFiles": "electron/domain.cjs" } },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/src/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
